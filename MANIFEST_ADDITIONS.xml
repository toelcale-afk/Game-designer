<!--
  Merge these into app/src/main/AndroidManifest.xml. Do not replace the whole file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Inside <manifest>, next to any other <uses-permission> lines -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- 2. Inside <application>, next to your <activity> -->
        <receiver
            android:name=".installer.InstallStatusReceiver"
            android:exported="false" />

        <!--
          3. Optional, on your main <activity>: keeps the activity alive when the
             Fold opens or closes. The installer state survives either way.
          android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
        -->
    </application>
</manifest>
