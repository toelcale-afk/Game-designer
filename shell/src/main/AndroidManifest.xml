<?xml version="1.0" encoding="utf-8"?>
<!--
  Literal placeholders on purpose: PackFlow rewrites "PackFlowShellAppName", the package
  (com.packflow.shell.placeholder) and the version in the compiled binary manifest.
  Keep the icon as PNG mipmaps only (no adaptive XML) so PackFlow can replace them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ShellApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PackFlowShellAppName"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:ignore="HardcodedText,MissingApplicationIcon">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:label="PackFlowShellAppName">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
